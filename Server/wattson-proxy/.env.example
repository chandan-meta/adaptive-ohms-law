# Copy to .env and fill in. Never commit .env and never put these keys in the Unity project.

# Chat: Anthropic Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
WATTSON_MODEL=claude-haiku-4-5-20251001

# Voice: ElevenLabs (https://elevenlabs.io > Developers > API keys). See README "Voice" for why these defaults.
ELEVENLABS_API_KEY=
# "Lawrence - Bright and Informative": bright, energetic, articulate male voice; a permanent ElevenLabs voice.
# Paste a Voice Design voice id here for a younger, more cartoon-like Wattson (README).
ELEVENLABS_VOICE_ID=ktkP7Nsj67dw2zcplQYt
# eleven_multilingual_v2: expressive, honours every setting below. eleven_flash_v2_5 is faster but flatter.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Delivery. Stability 0-1 (lower = livelier), similarity 0-1, style 0-1 (expressiveness), speed 0.7-1.2.
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=1
ELEVENLABS_SPEED=1.05
# /tts calls per session per 10 minutes. 200 covers live answers; set 400 while baking every line from scratch.
TTS_LIMIT=200

# Speech-to-text: OpenAI transcription
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

PORT=3000
# Set to 1 to print questions and answers to the console while testing. Audio is never logged.
LOG_TEXT=0
