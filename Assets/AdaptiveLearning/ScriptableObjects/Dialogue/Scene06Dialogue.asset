MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 118899cb856d7e04bac83f4463fd3b31, type: 3}
  m_Name: Scene06Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::AdaptiveOhmsLaw.DialogueSequence
  lines:
  - id: detective
    speaker: WATTSON
    text: Detective test.
    audio: {fileID: 8300000, guid: 18ed5c28e8f7a014f812e69e70441ff6, type: 3}
    duration: 2.4
    emotion: Curious
    nextEvent: 
  - id: question
    speaker: WATTSON
    text: If we increase the potential difference while everything else stays the
      same, what do you predict will happen to the current?
    audio: {fileID: 8300000, guid: 095858cb7c4f10046bd8911fd0cbad90, type: 3}
    duration: 7.298118
    emotion: Curious
    nextEvent: 
  - id: accepted
    speaker: WATTSON
    text: Interesting. Remember your answer. Let's see if Ohm's experiment agrees
      with you.
    audio: {fileID: 8300000, guid: fdc8e3e54cb248542a991fabd6ba2457, type: 3}
    duration: 6.7633786
    emotion: Curious
    nextEvent: 
  - id: curious
    speaker: WATTSON
    text: Interesting prediction.
    audio: {fileID: 8300000, guid: 7c37037e43fa66b469c924c8ef19f0fc, type: 3}
    duration: 2.174127
    emotion: Curious
    nextEvent: 
  - id: retry
    speaker: WATTSON
    text: Watch the charges carefully. Do you want to keep your answer or try again?
    audio: {fileID: 8300000, guid: 0438ab93e12aad34b9e44519ffaee369, type: 3}
    duration: 5.758662
    emotion: Curious
    nextEvent: 
  - id: supported
    speaker: WATTSON
    text: Same wire. Greater electrical push. Notice the stronger net drift. You
      can try another prediction or keep yours for the experiment.
    audio: {fileID: 8300000, guid: f092bb5fe980c6b48a3afba3176b440d, type: 3}
    duration: 10.662562
    emotion: Curious
    nextEvent: 
  - id: keep
    speaker: WATTSON
    text: Let's keep your prediction. Experiments help us test our ideas, and we
      can revise them as we learn.
    audio: {fileID: 8300000, guid: 4ab1e45e96e54c54e8665542fa2ae9bc, type: 3}
    duration: 7.61322
    emotion: Curious
    nextEvent: 
  - id: complete
    speaker: WATTSON
    text: Prediction recorded. Let's test it in Ohm's experiment.
    audio: {fileID: 8300000, guid: fbd0def84b740c3408b281719bab3f60, type: 3}
    duration: 4.823696
    emotion: Curious
    nextEvent: 
