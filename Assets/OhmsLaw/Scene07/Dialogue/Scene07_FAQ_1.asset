  m_Script: {fileID: 11500000, guid: e321f8acb9d249740835376e3c95cd0f, type: 3}
  m_Name: Scene07_FAQ_1
  m_EditorClassIdentifier: Assembly-CSharp::OhmsLaw.DialogueLine
  id: Scene07_FAQ_1
  speaker: WATTSON
  text: 'One reading can fool you: a wobble in the needle, a warm wire, a loose contact.
    Ohm repeated every measurement so that only the real pattern was left when the
    accidents averaged out. That is what careful detectives do with evidence.'
  ttsText: 'One reading can fool you: a wobble in the needle, a warm wire, a loose
