  m_Script: {fileID: 11500000, guid: 73abd5ac62af4a1449db4a5362b7f9d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OhmsLaw.InteractionGate
  m_Time: 35.76802699565887
  gateId: S10_Pattern
  description: "MCQ (graded, adaptive): A. Current increases as potential difference
    increases. \xB7 B. Current decreases. \xB7 C. There is no pattern. (correct A)
    \u2192 LearnerSession.s10PatternAnswer. Wrong: S10_Pattern_FB/_FC, panel hint,
    S10_R_WRONG (not for a Confident learner), re-ask with the wrong option out;
    a Struggling learner gets rows 1-2 highlighted and the easier question (S10_Pattern_E).
    Out of retries: the V then I column sweep with S10_Pattern_X."
  lines:
  - {fileID: 11400000, guid: af26046e0ad7d674893bf2f4bdbfb992, type: 2}
  - {fileID: 11400000, guid: f79825fb9714d494eb6eae5488dfd734, type: 2}
