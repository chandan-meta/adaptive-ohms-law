  m_EditorClassIdentifier: Assembly-CSharp::OhmsLaw.CalloutDef
  id: resistance
  title: Resistance (R)
  description: 'How much a conductor opposes the flow of current. Same voltage, less
    current = more resistance. The charges are not lost: they just get through more
    slowly.'
  anchor: 0
  kind: 2
  diagram: 0
