  m_Script: {fileID: 11500000, guid: e321f8acb9d249740835376e3c95cd0f, type: 3}
  m_Name: Scene11_FAQ_1
  m_EditorClassIdentifier: Assembly-CSharp::OhmsLaw.DialogueLine
  id: Scene11_FAQ_1
  speaker: WATTSON
  text: 'Think about zero volts: no push, so no current, which is the point zero-zero.
    And every reading doubled together with its partner: 1 volt, 0.2 ampere; 2 volts,
    0.4 ampere. Points that scale together like that always line up on a straight
    line that starts at the origin.'
  ttsText: 'Think about zero volts: no push, so no current, which is the point zero-zero.
    And every reading doubled together with its partner: 1 volt, 0.2 ampere; 2 volts,
    0.4 ampere. Points that scale together like that always line up on a straight
    line that starts at the origin.'
